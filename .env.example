# SmartClass Vision AI - Environment Configuration Example

# Environment Mode: development, staging, or production
ENVIRONMENT=development

# Camera Settings
CAMERA_INDEX=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080

# Application Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Database
DB_PATH=database/smartclass.sqlite

# MongoDB Application Data Layer (Phase 13)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=smartclass_vision_ai
MONGODB_TIMEOUT_MS=1500
MONGODB_MAX_POOL_SIZE=50

# Recognition Engine (Not active in Phase 2)
# RECOGNITION_THRESHOLD=0.65
